import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score
import matplotlib.pyplot as plt
import matplotlib

# 设置支持中文的字体（如果系统支持SimHei字体）
plt.rcParams['font.sans-serif'] = ['SimHei']  # 或尝试 'Arial Unicode MS'、'Heiti TC'
plt.rcParams['axes.unicode_minus'] = False  # 解决负号显示问题

# 加载数据集
data = pd.read_csv('realtor-data.csv')  # 确保文件路径正确

# 选择特征和目标变量
features = ['bed', 'bath', 'acre_lot', 'house_size']
target = 'price'

# 删除目标变量缺失的行
data = data.dropna(subset=[target])

# 选择特征和目标
X = data[features]
y = data[target]

# 处理特征中的缺失值，用均值填充
X = X.fillna(X.mean())

# 处理异常值：移除价格异常高的数据（例如，超过99分位的价格）
price_threshold = y.quantile(0.99)
data_cleaned = data[y <= price_threshold]
X_cleaned = data_cleaned[features]
y_cleaned = data_cleaned[target]

# 再次填充缺失值
X_cleaned = X_cleaned.fillna(X_cleaned.mean())

# 划分训练集和测试集
X_train, X_test, y_train, y_test = train_test_split(X_cleaned, y_cleaned, test_size=0.2, random_state=42)

# 训练线性回归模型
model = LinearRegression()
model.fit(X_train, y_train)

# 在测试集上预测
y_pred = model.predict(X_test)

# 评估模型
r2 = r2_score(y_test, y_pred)
mse = mean_squared_error(y_test, y_pred)
print(f'R-squared: {r2}')
print(f'MSE: {mse}')

# 输出回归系数
coefficients = pd.DataFrame(model.coef_, features, columns=['Coefficient'])
print(coefficients)

# 可视化预测值与实际值（使用英文标签，避免字体问题）
plt.scatter(y_test, y_pred, color='blue', label='Predicted vs Actual')
plt.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', lw=2, label='Perfect Prediction Line')
plt.xlabel('Actual Price (USD)')
plt.ylabel('Predicted Price (USD)')
plt.title('Predicted vs Actual House Prices')
plt.legend()
plt.savefig('prediction_vs_actual.png')
plt.show()
